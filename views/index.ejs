<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AI Chatbot</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="container">
    <!-- Header Section -->
    <header class="header">
      <h1>AI Chatbot</h1>
      <button id="clearHistoryBtn" class="btn-clear">Clear History</button>
    </header>

    <!-- Chat Messages Area -->
    <div id="chatMessages" class="chat-messages"></div>

    <!-- Typing Indicator -->
    <div id="typingIndicator" class="typing-indicator" style="display: none;">
      <div class="typing-dots">
        <span></span>
        <span></span>
        <span></span>
      </div>
      <span>AI is thinking...</span>
    </div>

    <!-- Error Message -->
    <div id="errorMessage" class="error-message" style="display: none;"></div>

    <!-- Input Area -->
    <div class="input-area">
      <!-- Hidden File Input -->
      <input type="file" id="fileInput" accept="image/*,application/pdf,text/*,.docx" style="display: none;">

      <!-- File Preview -->
      <div id="filePreview" class="file-preview" style="display: none;">
        <div class="file-info">
          <span id="fileName"></span>
          <span id="fileSize"></span>
        </div>
        <img id="fileThumbnail" class="file-thumbnail" style="display: none;">
        <button id="removeFileBtn" class="btn-remove">×</button>
      </div>

      <!-- Input Controls -->
      <div class="input-controls">
        <textarea
          id="messageInput"
          class="message-input"
          placeholder="Type your message..."
          rows="1"
        ></textarea>
        <button id="attachFileBtn" class="btn-attach" title="Attach File">📎</button>
        <button id="sendButton" class="btn-send">Send</button>
      </div>
    </div>
  </div>

  <script src="/js/chat.js"></script>
</body>
</html>
