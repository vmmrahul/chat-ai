<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AI Chatbot</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="container">
    <!-- Header Section -->
    <header class="header">
      <h1>AI Chatbot</h1>
      <button id="clearHistoryBtn" class="btn-clear">Clear History</button>
      <button id="exportBtn" class="btn-export">Export</button>
    </header>

    <!-- Chat Messages Area -->
    <div id="chatMessages" class="chat-messages"></div>

    <!-- Typing Indicator -->
    <div id="typingIndicator" class="typing-indicator" style="display: none;">
      <div class="typing-dots">
        <span></span>
        <span></span>
        <span></span>
      </div>
      <span>AI is thinking...</span>
    </div>

    <!-- Error Message -->
    <div id="errorMessage" class="error-message" style="display: none;"></div>

    <!-- Input Area -->
    <div class="input-area">
      <!-- Hidden File Input -->
      <input type="file" id="fileInput" accept="image/*,application/pdf,text/*,.docx" multiple style="display: none;">

      <!-- File Preview for Multiple Files -->
      <div id="filePreview" class="file-preview" style="display: none;">
        <div class="files-header">
          <span id="filesCountDisplay">Files Selected (0)</span>
          <button id="clearFilesBtn" class="btn-clear-all">Clear All</button>
        </div>
        <div id="filesList" class="files-list"></div>
      </div>

      <!-- Input Controls -->
      <div class="input-controls">
        <textarea
          id="messageInput"
          class="message-input"
          placeholder="Type your message..."
          rows="1"
        ></textarea>
        <button id="attachFileBtn" class="btn-attach" title="Attach File">📎</button>
        <button id="sendButton" class="btn-send">Send</button>
      </div>
    </div>

    <!-- Export Modal -->
    <div id="exportModal" class="modal-overlay" style="display: none;">
      <div class="modal-content">
        <!-- Step 1: Format Selection (shown initially) -->
        <div id="formatSelectionStep">
          <h2 class="modal-title">Select Export Format</h2>
          <div class="format-grid">
            <button class="format-btn" data-format="json">📄 JSON</button>
            <button class="format-btn" data-format="markdown">📝 Markdown</button>
            <button class="format-btn" data-format="txt">📋 Plain Text</button>
            <button class="format-btn" data-format="pdf">📕 PDF</button>
            <button class="format-btn" data-format="docx">📘 Word</button>
            <button class="format-btn" data-format="xlsx">📊 Excel</button>
          </div>
          <div class="modal-actions">
            <button id="modalCancelBtn" class="btn-cancel">Cancel</button>
          </div>
        </div>

        <!-- Step 2: Name Customization (shown after format selected) -->
        <div id="nameCustomizationStep" style="display: none;">
          <h2 class="modal-title" id="nameStepTitle">Export as JSON</h2>
          <div class="name-field">
            <label for="customFileName">File Name</label>
            <input type="text" id="customFileName" placeholder="chat-export" value="chat-export">
            <div class="filename-preview" id="filenamePreview">
              Will be saved as: chat-export-2025-11-01-143045.json
            </div>
          </div>
          <div class="modal-actions">
            <button id="backToFormatsBtn" class="btn-secondary">Back</button>
            <button id="confirmExportBtn" class="btn-primary">Download</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="/js/chat.js"></script>
</body>
</html>
